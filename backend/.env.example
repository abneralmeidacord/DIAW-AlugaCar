# Copie para .env nesta pasta. Estas credenciais ficam somente no backend.
# Supabase > Connect > Session pooler (porta 5432).
SUPABASE_DB_URL=jdbc:postgresql://SEU-HOST.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU-PROJECT-REF
SUPABASE_DB_PASSWORD=SUA-SENHA-DO-BANCO
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
APP_ALLOW_FIRST_CONTACT=true
APP_SEED_DEMO=false
# Execute src/main/resources/db/migration/schema.sql no Supabase ou use always na inicialização.
DB_INIT_MODE=never
